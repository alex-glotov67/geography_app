# Скопіюй у .env.local і заповни. .env.local у git не потрапляє.
# Лише публічні значення: URL проєкту і publishable key (`sb_publishable_…`).
# Secret key (`sb_secret_…`) і service role key сюди НЕ класти — вони живуть тільки в секретах
# Edge Functions і GitHub Actions.

# Локальний Supabase (`npm run db:start` виводить ці значення; демо-ключі CLI однакові на всіх машинах):
VITE_SUPABASE_URL=http://127.0.0.1:54321
