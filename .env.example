# Скопіюй у .env.local і заповни. .env.local у git не потрапляє.
# Лише публічні значення: URL проєкту і anon key. Service role key сюди НЕ класти — він живе
# тільки в секретах Edge Functions і GitHub Actions.

# Локальний Supabase (`npm run db:start` виводить ці значення):
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
